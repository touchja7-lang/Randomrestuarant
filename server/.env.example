# MongoDB Connection URI (Optional: If omitted or unreachable, system automatically runs embedded mode)
MONGODB_URI=mongodb://localhost:27017/random-restaurant

# Port for server (Cloud hosts like Render, Railway inject this automatically)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=production

# JWT Secret Key
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Client URL for CORS (Optional: leave empty to accept requests from all origins or specify https://your-domain.com)
CLIENT_URL=
